{
  "name": "gladys-apsystems",
  "version": "0.1.1",
  "private": true,
  "description": "APsystems EZ1 micro-inverters (local API) and ECU gateways (ECU-B, ECU-R, ECU-C, local port 8899) for Gladys Assistant: live production per panel, daily and lifetime energy, power limit and on/off on the EZ1, alarms, scene triggers and a dashboard widget.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "audit": "npm audit --omit=dev"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LM1LC3N7/gladys-apsystems.git"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0"
}
